  "paths": {
    "/calendar/api/v1/availability": {
      "get": {
        "operationId": "calendar_api_v1_availability_retrieve",
        "description": "Free/busy + open booking slots for the requesting user over a range.\n\n**Permissions:** `IsAuthenticated`",
        "parameters": [
          {
            "in": "query",
            "name": "end",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Inclusive end of the range (ISO 8601). Defaults to now + DEFAULT_EXPANSION_HORIZON_DAYS (90 by default). An end before start is 400 error.400.calendar_invalid_range."
          },
          {
            "in": "query",
            "name": "slot_minutes",
            "schema": {
              "type": "integer"
            },
            "description": "Length of a bookable slot, in minutes. Must be >= 1 — zero or negative is 400 error.400.calendar_invalid_slot_minutes, not a clamped value. Defaults to DEFAULT_SLOT_MINUTES (30)."
          },
          {
            "in": "query",
            "name": "start",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Inclusive start of the range (ISO 8601; naive values are read in the server's timezone). Defaults to now."
          }
        ],
        "tags": [
          "Calendar"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          },
          {
            "JWTBearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StapelError"
                }
              }
            },
            "description": "Bad Request",
            "x-stapel-errors": [
              "error.400.calendar_invalid_range",
              "error.400.calendar_invalid_slot_minutes"
            ]
          }
        }
      }
    },
